plugins {
    id 'com.android.application'
    id 'org.jetbrains.kotlin.android'
}

android {
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
    kotlinOptions {
        jvmTarget = "17"
    }
    namespace "com.example.webviewapp"
    compileSdk 35

    defaultConfig {
        applicationId "com.example.webviewapp"
        minSdk 26
        targetSdk 35
        versionCode 1
        versionName "1.0"
    }

    buildTypes {
        release { signingConfig signingConfigs.release }
        release {
            minifyEnabled false
        }
    }
}

dependencies {
    implementation "androidx.appcompat:appcompat:1.7.0"
}

android {
    signingConfigs {
        release { storeFile file("../siber-radar-release.jks"); storePassword "Totik01*"; keyAlias "siber-radar"; keyPassword "Totik01*" }
        release {
            storeFile file("../gozcu-radar.keystore")
            storePassword "Totik01*"
            keyAlias "gozcu-radar"
            keyPassword "Totik01*"
        }
    }
}
