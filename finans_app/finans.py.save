






cat <<EOF > finans.py
import yfinance as yf

# Apple hissesi verisi
hisse = yf.Ticker("AAPL")
veri = hisse.history(period="5d", auto_adjust=False)

# Zaman dilimi hatasını giderme
if veri.index.tz is not None:
    veri.index = veri.index.tz_localize(None)

print(veri[['Close']])
EOF
f

# Apple (AAPL) hissesi için örnek
hisse = yf.Ticker("AAPL")
veri = hisse.history(period="5d")

print(veri[['Close']])
